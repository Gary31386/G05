obesity_model <- fit_replicate_glm(general_primary, obesity_formula, general_repweights)
high_waist_model <- fit_replicate_glm(general_primary, high_waist_formula, general_repweights)

binary_sensitivity <- bind_rows(
  logistic_table(obesity_model) %>%
    filter(term == "fibre_5g_c:paMet") %>% mutate(outcome = "BMI-defined obesity"),
  logistic_table(high_waist_model) %>%
    filter(term == "fibre_5g_c:paMet") %>% mutate(outcome = "Elevated waist circumference")
)

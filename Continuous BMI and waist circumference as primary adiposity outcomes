  )
```

## Prespecified sensitivity analyses

The following checks target distinct concerns rather than searching for statistical significance:

1. use area-level SEIFA instead of individual income and education;
2. trim the outer 1% of fibre, energy, alcohol and each outcome;
3. remove the 1% most influential observations according to Cook's distance;
4. use robust M-estimation as an exploratory check;
5. analyse clinically defined binary obesity and elevated waist circumference.

```{r sensitivity-models}
seifa_covariates <- "ns(age, df = 3) + sex + energy_1000 + seifa + smoking + alcohol_10"

bmi_seifa <- fit_replicate_lm(
  general_seifa,
  as.formula(paste("bmi ~ fibre_5g_c * pa +", seifa_covariates)),
  general_repweights
)
waist_seifa <- fit_replicate_lm(
  general_seifa,
  as.formula(paste("waist_cm ~ fibre_5g_c * pa +", seifa_covariates)),
  general_repweights
)

trim_vars <- c("fibre_avg_g", "energy_avg_kj", "alcohol_avg_g", "bmi", "waist_cm")
trim_bounds <- lapply(trim_vars, function(v) {
  quantile(general_primary[[v]], c(.01, .99), na.rm = TRUE)
})
names(trim_bounds) <- trim_vars

trimmed <- general_primary
for (v in trim_vars) {
  trimmed <- trimmed[
    trimmed[[v]] >= trim_bounds[[v]][1] & trimmed[[v]] <= trim_bounds[[v]][2],
  ]
}
trimmed <- droplevels(trimmed)

bmi_trim <- fit_replicate_lm(trimmed, bmi_formula, general_repweights)
waist_trim <- fit_replicate_lm(trimmed, waist_formula, general_repweights)

bmi_cook_cut <- quantile(cooks.distance(bmi_model$fit), .99, na.rm = TRUE)
waist_cook_cut <- quantile(cooks.distance(waist_model$fit), .99, na.rm = TRUE)
bmi_low_influence <- general_primary[cooks.distance(bmi_model$fit) <= bmi_cook_cut, ]
waist_low_influence <- general_primary[cooks.distance(waist_model$fit) <= waist_cook_cut, ]

bmi_influence <- fit_replicate_lm(bmi_low_influence, bmi_formula, general_repweights)
waist_influence <- fit_replicate_lm(waist_low_influence, waist_formula, general_repweights)

fit_robust <- function(formula, data) {
  fit_data <- data
  fit_data$.analysis_weight <- fit_data$main_weight / mean(fit_data$main_weight)
  MASS::rlm(formula, data = fit_data, weights = .analysis_weight, maxit = 100)
}

bmi_robust <- fit_robust(bmi_formula, general_primary)
waist_robust <- fit_robust(waist_formula, general_primary)

extract_interaction <- function(model, label, outcome) {
  row <- continuous_table(model) %>% filter(term == "fibre_5g_c:paMet")
  data.frame(
    analysis = label, outcome = outcome, n = nrow(model$data),
    estimate = row$estimate, ci_low = row$ci_low,
    ci_high = row$ci_high, p_value = row$p_value
  )
}

robust_row <- function(fit, label, outcome, n) {
  tab <- summary(fit)$coefficients
  estimate <- tab["fibre_5g_c:paMet", "Value"]
  se <- tab["fibre_5g_c:paMet", "Std. Error"]
  data.frame(
    analysis = label, outcome = outcome, n = n,
    estimate = estimate, ci_low = estimate - 1.96 * se,
    ci_high = estimate + 1.96 * se,
    p_value = 2 * pnorm(abs(estimate / se), lower.tail = FALSE)
  )
}

continuous_sensitivity <- bind_rows(
  extract_interaction(bmi_model, "Primary individual SES", "BMI"),
  extract_interaction(waist_model, "Primary individual SES", "Waist circumference"),
  extract_interaction(bmi_seifa, "Replace income/education with SEIFA", "BMI"),
  extract_interaction(waist_seifa, "Replace income/education with SEIFA", "Waist circumference"),
  extract_interaction(bmi_trim, "Trim outer 1%", "BMI"),
  extract_interaction(waist_trim, "Trim outer 1%", "Waist circumference"),
  extract_interaction(bmi_influence, "Remove top 1% Cook's distance", "BMI"),
  extract_interaction(waist_influence, "Remove top 1% Cook's distance", "Waist circumference"),
  robust_row(bmi_robust, "Robust M-estimation", "BMI", nrow(general_primary)),
  robust_row(waist_robust, "Robust M-estimation", "Waist circumference", nrow(general_primary))
)

obesity_formula <- as.formula(paste(
  "obese ~ fibre_5g_c * pa +", primary_covariates
))
high_waist_formula <- as.formula(paste(
  "high_waist ~ fibre_5g_c * pa +", primary_covariates

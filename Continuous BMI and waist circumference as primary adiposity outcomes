The binary models answer a different question from the continuous models: they estimate whether PA changes the fibre association with the odds of crossing a threshold, rather than whether PA changes the average BMI or waist slope.

# Flexible-model checks

GAMs, regression trees, random forests and neural networks are used here as diagnostic predictive checks. They are not substitutes for the prespecified survey-weighted interaction model unless they show a clear, reproducible improvement in held-out prediction.

```{r continuous-model-comparison}
set.seed(3888)
fold_id <- sample(rep(1:5, length.out = nrow(general_primary)))

predictive_formula <- function(outcome) {
  as.formula(paste(
    outcome,
    "~ fibre_5g_c * pa + age + sex + energy_1000 + income_decile + year12 + smoking + alcohol_10"
  ))
}

flexible_formula <- function(outcome) {
  as.formula(paste(
    outcome,
    "~ fibre_5g_c + pa + age + sex + energy_1000 + income_decile + year12 + smoking + alcohol_10"
  ))
}

gam_formula <- function(outcome) {
  as.formula(paste(
    outcome,
    "~ pa + s(fibre_5g_c, by = pa, k = 5) + s(age, k = 5) + sex +",
    "s(energy_1000, k = 5) + income_decile + year12 + smoking + s(alcohol_10, k = 5)"
  ))
}

cv_outcome <- function(outcome) {
  result <- list()
  k <- 1

  for (fold in 1:5) {
    train <- general_primary[fold_id != fold, ]
    test <- general_primary[fold_id == fold, ]
    y_test <- test[[outcome]]

    lm_fit <- lm(predictive_formula(outcome), data = train, weights = main_weight)
    gam_fit <- mgcv::gam(gam_formula(outcome), data = train,
                         weights = main_weight, method = "REML")
    tree_fit <- rpart::rpart(flexible_formula(outcome), data = train,
                             weights = main_weight, method = "anova",
                             control = rpart.control(cp = .005, minbucket = 40))

    preds <- list(
      `Linear interaction model` = predict(lm_fit, newdata = test),
      `Generalised additive model` = predict(gam_fit, newdata = test),
      `Regression tree` = predict(tree_fit, newdata = test)
    )

    if (has_rf) {
      rf_fit <- randomForest::randomForest(
        flexible_formula(outcome), data = train,
        weights = train$main_weight, ntree = 250, nodesize = 20
      )
      preds[["Random forest"]] <- predict(rf_fit, newdata = test)
    }

    neural_formula <- predictive_formula(outcome)
    neural_fit <- nnet::nnet(
      neural_formula, data = train, weights = main_weight,
      size = 4, linout = TRUE, decay = .01, maxit = 300, trace = FALSE
    )
    preds[["Neural network"]] <- as.numeric(predict(neural_fit, newdata = test))

    for (model_name in names(preds)) {
      result[[k]] <- data.frame(
        outcome = outcome,
        fold = fold,
        model = model_name,
        RMSE = weighted_rmse(y_test, preds[[model_name]], test$main_weight),
        MAE = weighted_mae(y_test, preds[[model_name]], test$main_weight),
        R2 = weighted_r2(y_test, preds[[model_name]], test$main_weight)
      )
      k <- k + 1
    }
  }

  bind_rows(result)
}

cv_results <- bind_rows(cv_outcome("bmi"), cv_outcome("waist_cm")) %>%
  mutate(outcome = recode(outcome, bmi = "BMI", waist_cm = "Waist circumference"))

cv_summary <- cv_results %>%
  group_by(outcome, model) %>%
  summarise(
    RMSE = mean(RMSE),
    MAE = mean(MAE),
    R2 = mean(R2),
    .groups = "drop"
  )
```

```{r model-comparison-table, echo=FALSE}
cv_summary %>%
  mutate(across(c(RMSE, MAE, R2), ~round(.x, 3))) %>%
  arrange(outcome, RMSE) %>%
  kable(caption = "Five-fold weighted predictive performance for continuous outcomes")
```

The simple linear interaction model remains the inferential model unless the flexible models clearly improve RMSE, MAE and R² together. A small predictive difference does not by itself establish a scientifically meaningful nonlinear interaction.

# Brief Indigenous complementary analysis

The Indigenous NATSINPAS analysis uses Day 1 fibre because few participants completed Day 2. It is a supportive replication check, not a formal comparison with the general-population sample.

```{r indigenous-analysis}
ind_person <- read.csv("dataset/inp13bsp.csv", check.names = FALSE)
ind_household <- read.csv("dataset/inp13bhh.csv", check.names = FALSE)
ind_person$SF2SA1DB <- ind_household$SF2SA1DB[match(ind_person$ABSHID, ind_household$ABSHID)]

ind_all <- ind_person %>%
  mutate(
    fibre_5g_c = (FIBRET1 - fibre_reference_g) / 5,
    bmi = BMISC,
    waist_cm = PHDCMWBC,
    pa = factor(ifelse(EXREGUIC == 1, "Met", "Not met"),
                levels = c("Not met", "Met")),
    sex = factor(ifelse(SEX == 1, "Men", "Women"),
                 levels = c("Men", "Women")),
    age = AGEEC,
    energy_1000 = ENERGYT1 / 1000,
    alcohol_10 = ALCT1 / 10,
    seifa = as.numeric(SF2SA1DB),
    smoking = factor(SMKSTAT),
    main_weight = IPAFINWT
  )

ind_keep <- with(ind_all,
  age >= 18 & age <= 65 &
    is.finite(FIBRET1) & FIBRET1 >= 0 &
    is.finite(bmi) & bmi >= 8 & bmi <= 80 &
    is.finite(waist_cm) & waist_cm >= 40 & waist_cm <= 200 &
    EXREGUIC %in% c(1, 2) & SEX %in% c(1, 2) &
    is.finite(energy_1000) & energy_1000 > 0 &
    is.finite(alcohol_10) & alcohol_10 >= 0 &
    SF2SA1DB %in% 1:5 & SMKSTAT %in% 1:5 &
    is.finite(main_weight) & main_weight > 0
)

ind_data <- droplevels(ind_all[ind_keep, ])
ind_repweights <- sprintf("WPM1%03d", 1:250)

ind_covariates <- "ns(age, df = 3) + sex + energy_1000 + seifa + smoking + alcohol_10"
ind_bmi_model <- fit_replicate_lm(
  ind_data,
  as.formula(paste("bmi ~ fibre_5g_c * pa +", ind_covariates)),
  ind_repweights
)
ind_waist_model <- fit_replicate_lm(
  ind_data,
  as.formula(paste("waist_cm ~ fibre_5g_c * pa +", ind_covariates)),
  ind_repweights
)

ind_results <- bind_rows(
  continuous_table(ind_bmi_model) %>%
    filter(term == "fibre_5g_c:paMet") %>% mutate(outcome = "BMI"),
  continuous_table(ind_waist_model) %>%
    filter(term == "fibre_5g_c:paMet") %>% mutate(outcome = "Waist circumference")
)
```


ind_results %>%
  transmute(
    Outcome = outcome,
    `Interaction estimate` = sprintf("%.2f", estimate),
    `95% CI` = sprintf("%.2f to %.2f", ci_low, ci_high),
    `p-value` = fmt_p(p_value)

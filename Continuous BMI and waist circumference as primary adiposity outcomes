weighted_mean <- function(x, w) sum(x * w, na.rm = TRUE) / sum(w[!is.na(x)])

weighted_sd <- function(x, w) {
  m <- weighted_mean(x, w)
  sqrt(weighted_mean((x - m)^2, w))
}

weighted_rmse <- function(y, pred, w) sqrt(weighted_mean((y - pred)^2, w))
weighted_mae <- function(y, pred, w) weighted_mean(abs(y - pred), w)
weighted_r2 <- function(y, pred, w) {
  1 - sum(w * (y - pred)^2) / sum(w * (y - weighted_mean(y, w))^2)
}

jackknife_variance <- function(beta, replicate_beta) {
  r <- ncol(replicate_beta)
  delta <- sweep(replicate_beta, 1, beta, "-")
  (r - 1) / r * tcrossprod(delta)
}

fit_replicate_lm <- function(data, formula, replicate_names) {
  fit_once <- function(w) {
    fit_data <- data
    fit_data$.analysis_weight <- w / mean(w)
    lm(formula, data = fit_data, weights = .analysis_weight)
  }

  full_fit <- fit_once(data$main_weight)
  beta <- coef(full_fit)
  rep_beta <- sapply(replicate_names, function(weight_name) {
    b <- coef(fit_once(data[[weight_name]]))
    aligned <- rep(NA_real_, length(beta))
    names(aligned) <- names(beta)
    aligned[names(b)] <- b
    aligned
  })

  if (anyNA(rep_beta)) stop("A replicate-weight linear fit dropped a coefficient.")
  variance <- jackknife_variance(beta, rep_beta)

  list(
    formula = formula,
    fit = full_fit,
    beta = beta,
    replicate_beta = rep_beta,
    variance = variance,
    se = sqrt(diag(variance)),
    data = data,
    replicate_names = replicate_names
  )
}

fit_replicate_glm <- function(data, formula, replicate_names) {
  fit_once <- function(w) {
    fit_data <- data
    fit_data$.analysis_weight <- w / mean(w)
    suppressWarnings(glm(
      formula, data = fit_data, family = binomial(),
      weights = .analysis_weight
    ))
  }

  full_fit <- fit_once(data$main_weight)
  beta <- coef(full_fit)
  rep_beta <- sapply(replicate_names, function(weight_name) {
    b <- coef(fit_once(data[[weight_name]]))
    aligned <- rep(NA_real_, length(beta))
    names(aligned) <- names(beta)
    aligned[names(b)] <- b
    aligned
  })

  if (anyNA(rep_beta)) stop("A replicate-weight logistic fit dropped a coefficient.")
  variance <- jackknife_variance(beta, rep_beta)

  list(
    formula = formula,
    fit = full_fit,
    beta = beta,
    replicate_beta = rep_beta,
    variance = variance,
    se = sqrt(diag(variance)),
    data = data,
    replicate_names = replicate_names
  )
}

continuous_table <- function(model) {
  data.frame(
    term = names(model$beta),
    estimate = unname(model$beta),
    se = unname(model$se),
    ci_low = unname(model$beta - 1.96 * model$se),
    ci_high = unname(model$beta + 1.96 * model$se),
    p_value = 2 * pnorm(abs(model$beta / model$se), lower.tail = FALSE),
    row.names = NULL
  )
}

logistic_table <- function(model) {
  tab <- continuous_table(model)
  transform(
    tab,
    odds_ratio = exp(estimate),
    or_low = exp(ci_low),
    or_high = exp(ci_high)
  )
}

linear_combination <- function(model, contrast, label) {
  contrast <- contrast[names(model$beta)]
  estimate <- sum(contrast * model$beta)
  variance <- as.numeric(t(contrast) %*% model$variance %*% contrast)
  se <- sqrt(variance)
  data.frame(
    effect = label,
    estimate = estimate,
    ci_low = estimate - 1.96 * se,
    ci_high = estimate + 1.96 * se,
    p_value = 2 * pnorm(abs(estimate / se), lower.tail = FALSE)
  )
}

standardised_predictions_lm <- function(model, fibre_values, pa_values = c("Not met", "Met")) {
  data <- model$data
  output <- list()
  k <- 1

  for (f in fibre_values) {
    for (p in pa_values) {
      newdata <- data
      newdata$fibre_5g_c <- (f - fibre_reference_g) / 5
      newdata$pa <- factor(p, levels = levels(data$pa))
      x <- model.matrix(delete.response(terms(model$fit)), newdata)
      mean_x <- colSums(x * data$main_weight) / sum(data$main_weight)
      estimate <- sum(mean_x * model$beta)
      se <- sqrt(as.numeric(t(mean_x) %*% model$variance %*% mean_x))
      output[[k]] <- data.frame(
        fibre_g = f,
        pa = p,
        estimate = estimate,
        ci_low = estimate - 1.96 * se,
        ci_high = estimate + 1.96 * se
      )
      k <- k + 1
    }
  }

  bind_rows(output) %>%
    mutate(pa = factor(pa, levels = pa_values))
}

weighted_quantile <- function(x, w, probs) {
  keep <- is.finite(x) & is.finite(w) & w > 0
  x <- x[keep]
  w <- w[keep]
  ord <- order(x)
  x <- x[ord]
  cw <- cumsum(w[ord]) / sum(w)
  sapply(probs, function(p) x[which(cw >= p)[1]])
}
